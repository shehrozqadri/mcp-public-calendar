# Copy to `.env` and fill in values for local development.
# On hosted platforms, set these as environment variables / secrets instead.

# MongoDB Atlas connection string
MONGO_URL=mongodb+srv://user:password@cluster.mongodb.net/

# Database name
DB_NAME=mcp-forge

# Public app URL (used for CORS). Leave empty to auto-detect from request host.
ALLOWED_ORIGIN=http://localhost:3000

# Optional: frontend API base URL. Leave empty when API and UI share the same origin.
# REACT_APP_BACKEND_URL=
